{
  "name": "After Mr. Stone's offer, the Builder builds a Poké Mart in Littleroot that buys farm goods",
  "build": "test_start",
  "setup": {"base": "delivery_service_running", "flags": ["FLAG_LITTLEROOT_MART_OFFERED"], "money": 5000, "items": [["POTION", 3]]},
  "steps": [
    {"action": "wait_overworld", "timeout_frames": 3000},
    {"action": "walk_to", "x": 9, "y": 25},
    {"action": "run", "frames": 2, "keys": ["UP"]},
    {"action": "run", "frames": 20},
    {"action": "screenshot", "name": "01-mart-ruins"},
    {"action": "walk_to", "x": 22, "y": 12},
    {"action": "run", "frames": 2, "keys": ["LEFT"]},
    {"action": "run", "frames": 20},
    {"action": "run", "frames": 2, "keys": ["A"]},
    {"action": "next_message", "times": 0},
    {"action": "run", "frames": 20},
    {"action": "screenshot", "name": "02-builder-offers-mart"},
    {"action": "run", "frames": 2, "keys": ["A"]},
    {"action": "next_message", "times": 0},
    {"action": "run", "frames": 20},
    {"action": "screenshot", "name": "03-confirm-mart"},
    {"action": "run", "frames": 2, "keys": ["A"]},
    {"action": "run", "frames": 60},
    {"action": "next_message", "times": 0},
    {"action": "next_message", "wait": 240},
    {"action": "screenshot", "name": "04-mart-built"},
    {"action": "dismiss_text"},
    {"action": "assert_money", "equals": 2000},
    {"action": "walk_to", "x": 9, "y": 24},
    {"action": "screenshot", "name": "05-mart-door"},
    {"action": "run", "frames": 16, "keys": ["UP"]},
    {"action": "wait_overworld", "timeout_frames": 600},
    {"action": "run", "frames": 30},
    {"action": "assert_position", "x": 3, "y": 7, "map": "MAP_LITTLEROOT_TOWN_MART"},
    {"action": "screenshot", "name": "06-inside-mart"},
    {"action": "remember_money"},
    {"action": "remember_bag"},
    {"action": "walk_to", "x": 3, "y": 3},
    {"action": "run", "frames": 2, "keys": ["LEFT"]},
    {"action": "run", "frames": 20},
    {"action": "run", "frames": 2, "keys": ["A"]},
    {"action": "press_until_task", "task": "Task_ShopMenu"},
    {"action": "run", "frames": 20},
    {"action": "screenshot", "name": "07-devon-buyer"},
    {"action": "press", "key": "A", "wait": 10},
    {"action": "wait_task", "task": "Task_BagMenu_HandleInput", "timeout_frames": 300},
    {"action": "run", "frames": 30},
    {"action": "press", "key": "A", "wait": 40},
    {"action": "press", "key": "A", "wait": 40},
    {"action": "press_until_task", "task": "Task_BagMenu_HandleInput"},
    {"action": "assert_money_gained", "min": 150, "max": 150},
    {"action": "assert_items_gained", "items": ["POTION"], "min": -1, "max": -1},
    {"action": "press", "key": "B", "wait": 10},
    {"action": "wait_task", "task": "Task_ShopMenu", "timeout_frames": 600},
    {"action": "press", "key": "B", "wait": 10},
    {"action": "dismiss_text"}
  ]
}

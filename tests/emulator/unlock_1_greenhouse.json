{
  "name": "Buy the Greenhouse for 5000 from the Builder, staff it, earn money and berries, take the worker back",
  "build": "test_start",
  "setup": {"base": "delivery_service_running", "money": 5000, "party": [["LOTAD", 5]]},
  "steps": [
    {"action": "wait_overworld", "timeout_frames": 3000},
    {"action": "walk_to", "x": 22, "y": 12},
    {"action": "run", "frames": 2, "keys": ["LEFT"]},
    {"action": "run", "frames": 20},
    {"action": "screenshot", "name": "01-builder-in-yard"},
    {"action": "run", "frames": 2, "keys": ["A"]},
    {"action": "next_message", "times": 0},
    {"action": "run", "frames": 20},
    {"action": "screenshot", "name": "02-builder-menu"},
    {"action": "run", "frames": 2, "keys": ["A"]},
    {"action": "next_message", "times": 0},
    {"action": "run", "frames": 20},
    {"action": "screenshot", "name": "03-confirm-purchase"},
    {"action": "run", "frames": 2, "keys": ["A"]},
    {"action": "run", "frames": 60},
    {"action": "next_message", "times": 0},
    {"action": "next_message", "wait": 240},
    {"action": "screenshot", "name": "04-greenhouse-built"},
    {"action": "dismiss_text"},
    {"action": "assert_money", "equals": 0},
    {"action": "walk_to", "x": 55, "y": 11},
    {"action": "run", "frames": 2, "keys": ["UP"]},
    {"action": "run", "frames": 20},
    {"action": "screenshot", "name": "05-greenhouse-and-terminal"},
    {"action": "run", "frames": 2, "keys": ["A"]},
    {"action": "next_message", "times": 0},
    {"action": "screenshot", "name": "06-terminal-intro"},
    {"action": "next_message"},
    {"action": "screenshot", "name": "07-needs-grass-or-bug"},
    {"action": "press_until_task", "task": "Task_HandleChooseMonInput"},
    {"action": "run", "frames": 30},
    {"action": "press", "key": "DOWN", "wait": 20},
    {"action": "screenshot", "name": "08-choose-lotad"},
    {"action": "press", "key": "A", "wait": 60},
    {"action": "next_message", "times": 0},
    {"action": "screenshot", "name": "09-lotad-to-work"},
    {"action": "dismiss_text"},
    {"action": "remember_money"},
    {"action": "remember_bag"},
    {"action": "walk", "path": ["DOWN 1", "LEFT 10", "RIGHT 10", "LEFT 10", "RIGHT 10", "LEFT 10", "RIGHT 10", "LEFT 10", "RIGHT 10", "LEFT 10", "RIGHT 10", "LEFT 10", "RIGHT 10", "LEFT 10", "RIGHT 10", "LEFT 10", "RIGHT 10", "LEFT 10", "RIGHT 10", "LEFT 10", "RIGHT 10", "UP 1"]},
    {"action": "assert_position", "x": 55, "y": 11},
    {"action": "run", "frames": 2, "keys": ["UP"]},
    {"action": "run", "frames": 20},
    {"action": "run", "frames": 2, "keys": ["A"]},
    {"action": "next_message", "times": 0},
    {"action": "screenshot", "name": "10-terminal-shows-lotad"},
    {"action": "next_message"},
    {"action": "run", "frames": 20},
    {"action": "screenshot", "name": "11-terminal-menu-with-stock"},
    {"action": "press", "key": "A", "wait": 30},
    {"action": "next_message", "times": 0},
    {"action": "screenshot", "name": "12-sold-berries"},
    {"action": "next_message"},
    {"action": "screenshot", "name": "13-pays-out"},
    {"action": "assert_money_gained", "min": 240, "max": 264},
    {"action": "press_until_task", "task": "Task_HandleMultichoiceInput"},
    {"action": "run", "frames": 20},
    {"action": "assert_items_gained", "items": ["ORAN_BERRY", "PECHA_BERRY", "CHERI_BERRY", "RAWST_BERRY", "CHESTO_BERRY", "ASPEAR_BERRY", "PERSIM_BERRY", "SITRUS_BERRY"], "min": 4, "max": 4},
    {"action": "press", "key": "DOWN", "times": 2, "wait": 10},
    {"action": "screenshot", "name": "14-take-worker-back"},
    {"action": "press", "key": "A", "wait": 30},
    {"action": "next_message", "times": 0},
    {"action": "screenshot", "name": "15-lotad-returned"},
    {"action": "dismiss_text"},
    {"action": "assert_party_level", "slot": 1, "min": 8, "max": 8}
  ]
}

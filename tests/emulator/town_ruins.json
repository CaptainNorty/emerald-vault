{
  "name": "Littleroot Town ruined-building plots",
  "build": "test_start",
  "steps": [
    {"action": "wait_overworld", "timeout_frames": 3000},
    {"action": "assert_position", "x": 5, "y": 9, "map": "MAP_LITTLEROOT_TOWN"},
    {"action": "screenshot", "name": "01-start-outside-home"},
    {"action": "walk", "path": ["LEFT 3", "DOWN 12"]},
    {"action": "screenshot", "name": "02-south-edge-opened"},
    {"action": "walk", "path": ["RIGHT 8", "DOWN 4"]},
    {"action": "assert_position", "x": 10, "y": 25},
    {"action": "screenshot", "name": "03-ruins-1-and-2"},
    {"action": "walk", "path": ["DOWN 4", "LEFT 2"]},
    {"action": "run", "frames": 2, "keys": ["UP"]},
    {"action": "run", "frames": 20},
    {"action": "run", "frames": 2, "keys": ["A"]},
    {"action": "run", "frames": 240},
    {"action": "screenshot", "name": "04-ruin-1-sign"},
    {"action": "dismiss_text"},
    {"action": "walk", "path": ["RIGHT 11", "UP 4"]},
    {"action": "assert_position", "x": 19, "y": 25},
    {"action": "screenshot", "name": "05-ruins-2-and-3"},
    {"action": "walk", "path": ["DOWN 8"]},
    {"action": "screenshot", "name": "06-ruins-5-and-6"},
    {"action": "walk", "path": ["DOWN 4", "LEFT 9", "UP 4"]},
    {"action": "screenshot", "name": "07-ruins-4-and-5"},
    {"action": "walk", "path": ["DOWN 8"]},
    {"action": "screenshot", "name": "08-ruins-7-and-8"},
    {"action": "walk", "path": ["DOWN 4", "RIGHT 9", "UP 4"]},
    {"action": "screenshot", "name": "09-ruins-8-and-9"},
    {"action": "walk", "path": ["RIGHT 1"]},
    {"action": "assert_blocked", "direction": "RIGHT"},
    {"action": "assert_position", "x": 20, "y": 41, "map": "MAP_LITTLEROOT_TOWN"}
  ]
}

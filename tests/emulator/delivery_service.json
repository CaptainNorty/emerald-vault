{
  "name": "Rebuild and staff the Delivery Service, earn money and items, fly out and whistle home",
  "build": "test_start",
  "setup": {"base": "after_pokedex", "party": [["WINGULL", 5]], "items": [["POKE_BALL", 5]]},
  "steps": [
    {"action": "wait_overworld", "timeout_frames": 3000},
    {"action": "screenshot", "name": "01-ruins-with-wingull-in-party"},
    {"action": "walk_to", "x": 25, "y": 11},
    {"action": "run", "frames": 2, "keys": ["UP"]},
    {"action": "run", "frames": 20},
    {"action": "run", "frames": 2, "keys": ["A"]},
    {"action": "next_message", "times": 0},
    {"action": "next_message", "times": 4},
    {"action": "screenshot", "name": "02-builder-sees-flying-type"},
    {"action": "next_message", "wait": 240},
    {"action": "screenshot", "name": "03-delivery-service-rebuilt"},
    {"action": "dismiss_text"},
    {"action": "screenshot", "name": "04-builder-moved-terminal-arrived"},
    {"action": "walk_to", "x": 27, "y": 10},
    {"action": "run", "frames": 2, "keys": ["UP"]},
    {"action": "run", "frames": 20},
    {"action": "run", "frames": 2, "keys": ["A"]},
    {"action": "next_message", "times": 0},
    {"action": "screenshot", "name": "05-terminal-asks-for-flying-type"},
    {"action": "press_until_task", "task": "Task_HandleChooseMonInput"},
    {"action": "run", "frames": 30},
    {"action": "press", "key": "DOWN", "wait": 20},
    {"action": "screenshot", "name": "06-choose-wingull"},
    {"action": "press", "key": "A", "wait": 60},
    {"action": "next_message", "times": 0},
    {"action": "screenshot", "name": "07-wingull-to-work"},
    {"action": "next_message", "times": 4},
    {"action": "screenshot", "name": "08-package-waiting"},
    {"action": "next_message", "times": 2, "wait": 30},
    {"action": "screenshot", "name": "09-received-bird-whistle"},
    {"action": "dismiss_text"},
    {"action": "remember_money"},
    {"action": "remember_bag"},
    {"action": "walk_to", "x": 10, "y": 3},
    {"action": "walk", "path": ["UP 4"]},
    {"action": "assert_position", "x": 10, "y": 19, "map": "MAP_ROUTE101"},
    {"action": "walk", "path": ["UP 2", "LEFT 8", "RIGHT 8", "LEFT 8", "RIGHT 8", "LEFT 8", "RIGHT 8", "LEFT 8", "RIGHT 8", "LEFT 8", "RIGHT 8", "LEFT 8", "RIGHT 8", "LEFT 8", "RIGHT 8", "LEFT 8", "RIGHT 8", "LEFT 8", "RIGHT 8", "LEFT 8", "RIGHT 8", "LEFT 8", "RIGHT 8", "LEFT 8", "RIGHT 8", "LEFT 4", "RIGHT 4", "DOWN 2"]},
    {"action": "walk", "path": ["DOWN 1"]},
    {"action": "assert_position", "x": 10, "y": 0, "map": "MAP_LITTLEROOT_TOWN"},
    {"action": "walk", "path": ["DOWN 3"]},
    {"action": "walk_to", "x": 27, "y": 10},
    {"action": "screenshot", "name": "10-back-from-route-101"},
    {"action": "run", "frames": 2, "keys": ["UP"]},
    {"action": "run", "frames": 20},
    {"action": "run", "frames": 2, "keys": ["A"]},
    {"action": "next_message", "times": 0},
    {"action": "screenshot", "name": "11-terminal-shows-worker"},
    {"action": "next_message"},
    {"action": "run", "frames": 20},
    {"action": "screenshot", "name": "12-terminal-menu-with-stock"},
    {"action": "press", "key": "A", "wait": 30},
    {"action": "next_message", "times": 0},
    {"action": "next_message"},
    {"action": "screenshot", "name": "13-collecting-items"},
    {"action": "assert_money_gained", "min": 0, "max": 0},
    {"action": "next_message", "times": 2},
    {"action": "screenshot", "name": "14-collected-items"},
    {"action": "press_until_task", "task": "Task_HandleMultichoiceInput"},
    {"action": "run", "frames": 20},
    {"action": "assert_items_gained", "items": ["POTION", "POKE_BALL", "ANTIDOTE", "REPEL", "ESCAPE_ROPE"], "min": 2, "max": 14},
    {"action": "screenshot", "name": "15-terminal-menu-after-collecting"},
    {"action": "press", "key": "DOWN", "times": 2, "wait": 10},
    {"action": "run", "frames": 2, "keys": ["A"]},
    {"action": "next_message", "times": 0},
    {"action": "screenshot", "name": "16-where-to"},
    {"action": "press", "key": "A", "wait": 150},
    {"action": "screenshot", "name": "17-fly-map"},
    {"action": "press", "key": "UP", "times": 2, "wait": 30},
    {"action": "screenshot", "name": "18-fly-map-oldale"},
    {"action": "press", "key": "A", "wait": 10},
    {"action": "wait_overworld", "timeout_frames": 3000},
    {"action": "assert_position", "x": 6, "y": 17, "map": "MAP_OLDALE_TOWN"},
    {"action": "screenshot", "name": "19-landed-in-oldale"},
    {"action": "walk_to", "x": 0, "y": 10},
    {"action": "screenshot", "name": "20-west-road-open"},
    {"action": "walk", "path": ["LEFT 1"]},
    {"action": "assert_position", "x": 49, "y": 10, "map": "MAP_ROUTE102"},
    {"action": "screenshot", "name": "21-on-route-102"},
    {"action": "press", "key": "START", "wait": 30},
    {"action": "press", "key": "DOWN", "times": 2, "wait": 10},
    {"action": "press", "key": "A", "wait": 30},
    {"action": "wait_task", "task": "Task_BagMenu_HandleInput", "timeout_frames": 300},
    {"action": "run", "frames": 30},
    {"action": "press", "key": "RIGHT", "times": 4, "wait": 45},
    {"action": "screenshot", "name": "22-bag-bird-whistle"},
    {"action": "press", "key": "A", "wait": 30},
    {"action": "screenshot", "name": "23-use-bird-whistle"},
    {"action": "press", "key": "A", "wait": 10},
    {"action": "wait_overworld", "timeout_frames": 3000},
    {"action": "assert_position", "x": 27, "y": 10, "map": "MAP_LITTLEROOT_TOWN"},
    {"action": "screenshot", "name": "24-whistled-home"}
  ]
}

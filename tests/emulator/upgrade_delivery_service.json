{
  "name": "Upgrade the Delivery Service to Lv. 2, add a second worker, earn tier 2 items at double speed",
  "build": "test_start",
  "setup": {"base": "delivery_service_running", "flags": ["FLAG_GREENHOUSE_BUILT"], "money": 5000, "party": [["TAILLOW", 5]]},
  "steps": [
    {"action": "wait_overworld", "timeout_frames": 3000},
    {"action": "walk_to", "x": 22, "y": 12},
    {"action": "run", "frames": 2, "keys": ["LEFT"]},
    {"action": "run", "frames": 20},
    {"action": "run", "frames": 2, "keys": ["A"]},
    {"action": "next_message", "times": 0},
    {"action": "run", "frames": 20},
    {"action": "screenshot", "name": "01-builder-offers-upgrades"},
    {"action": "run", "frames": 2, "keys": ["A"]},
    {"action": "next_message", "times": 0},
    {"action": "run", "frames": 20},
    {"action": "screenshot", "name": "02-confirm-upgrade"},
    {"action": "run", "frames": 2, "keys": ["A"]},
    {"action": "run", "frames": 60},
    {"action": "next_message", "times": 0},
    {"action": "next_message", "wait": 240},
    {"action": "screenshot", "name": "03-upgraded"},
    {"action": "dismiss_text"},
    {"action": "assert_money", "equals": 0},
    {"action": "walk_to", "x": 27, "y": 10},
    {"action": "run", "frames": 2, "keys": ["UP"]},
    {"action": "run", "frames": 20},
    {"action": "run", "frames": 2, "keys": ["A"]},
    {"action": "next_message", "times": 0},
    {"action": "screenshot", "name": "04-one-of-two-workers"},
    {"action": "next_message", "times": 2},
    {"action": "run", "frames": 20},
    {"action": "screenshot", "name": "05-terminal-menu"},
    {"action": "press", "key": "DOWN", "times": 2, "wait": 10},
    {"action": "press", "key": "A", "wait": 30},
    {"action": "assert_task", "task": "Task_TownListMenu"},
    {"action": "press", "key": "DOWN", "wait": 20},
    {"action": "screenshot", "name": "06-choose-empty-slot"},
    {"action": "press", "key": "A", "wait": 30},
    {"action": "press_until_task", "task": "Task_HandleChooseMonInput"},
    {"action": "run", "frames": 30},
    {"action": "press", "key": "DOWN", "wait": 20},
    {"action": "press", "key": "A", "wait": 60},
    {"action": "next_message", "times": 0},
    {"action": "screenshot", "name": "07-taillow-joins"},
    {"action": "dismiss_text"},
    {"action": "remember_money"},
    {"action": "remember_bag"},
    {"action": "walk_to", "x": 10, "y": 3},
    {"action": "walk", "path": ["UP 4"]},
    {"action": "assert_position", "x": 10, "y": 19, "map": "MAP_ROUTE101"},
    {"action": "walk", "path": ["UP 2", "LEFT 8", "RIGHT 8", "LEFT 8", "RIGHT 8", "LEFT 8", "RIGHT 8", "LEFT 8", "RIGHT 8", "LEFT 8", "RIGHT 8", "LEFT 8", "RIGHT 8", "LEFT 8", "RIGHT 8", "LEFT 8", "RIGHT 8", "LEFT 8", "RIGHT 8", "LEFT 8", "RIGHT 8", "LEFT 8", "RIGHT 8", "LEFT 8", "RIGHT 8", "LEFT 4", "RIGHT 4", "DOWN 2"]},
    {"action": "walk", "path": ["DOWN 1"]},
    {"action": "assert_position", "x": 10, "y": 0, "map": "MAP_LITTLEROOT_TOWN"},
    {"action": "walk", "path": ["DOWN 3"]},
    {"action": "walk_to", "x": 27, "y": 10},
    {"action": "run", "frames": 2, "keys": ["UP"]},
    {"action": "run", "frames": 20},
    {"action": "run", "frames": 2, "keys": ["A"]},
    {"action": "next_message", "times": 0},
    {"action": "screenshot", "name": "08-two-workers"},
    {"action": "next_message", "times": 2},
    {"action": "run", "frames": 20},
    {"action": "screenshot", "name": "09-stock-after-200-steps"},
    {"action": "press", "key": "A", "wait": 30},
    {"action": "next_message", "times": 0},
    {"action": "next_message"},
    {"action": "screenshot", "name": "10-collecting-items"},
    {"action": "assert_money_gained", "min": 0, "max": 0},
    {"action": "press_until_task", "task": "Task_HandleMultichoiceInput"},
    {"action": "run", "frames": 20},
    {"action": "assert_items_gained", "items": ["SUPER_POTION", "GREAT_BALL", "PARALYZE_HEAL", "SUPER_REPEL", "AWAKENING", "ESCAPE_ROPE"], "min": 8, "max": 8},
    {"action": "press", "key": "DOWN", "times": 3, "wait": 10},
    {"action": "press", "key": "A", "wait": 30},
    {"action": "assert_task", "task": "Task_TownListMenu"},
    {"action": "screenshot", "name": "11-take-back-which-worker"},
    {"action": "press", "key": "DOWN", "wait": 20},
    {"action": "press", "key": "A", "wait": 30},
    {"action": "next_message", "times": 0},
    {"action": "screenshot", "name": "12-taillow-returned"},
    {"action": "dismiss_text"},
    {"action": "assert_party_level", "slot": 1, "min": 7, "max": 7}
  ]
}

{
  "name": "The Builder offers the FISHERY once its requirement (the Old Rod) is met",
  "build": "test_start",
  "setup": {"base": "delivery_service_running", "flags": ["FLAG_BADGE01_GET", "FLAG_RECEIVED_OLD_ROD", "FLAG_GREENHOUSE_BUILT", "FLAG_QUARRY_BUILT"], "money": 45000, "party": [["MAGIKARP", 15]]},
  "steps": [
    {"action": "wait_overworld", "timeout_frames": 3000},
    {"action": "walk_to", "x": 22, "y": 12},
    {"action": "run", "frames": 2, "keys": ["LEFT"]},
    {"action": "run", "frames": 20},
    {"action": "run", "frames": 2, "keys": ["A"]},
    {"action": "next_message", "times": 0},
    {"action": "run", "frames": 20},
    {"action": "screenshot", "name": "01-builder-offers-fishery"},
    {"action": "run", "frames": 2, "keys": ["A"]},
    {"action": "next_message", "times": 0},
    {"action": "run", "frames": 20},
    {"action": "screenshot", "name": "02-confirm-purchase"},
    {"action": "run", "frames": 2, "keys": ["A"]},
    {"action": "run", "frames": 60},
    {"action": "next_message", "times": 0},
    {"action": "next_message", "wait": 240},
    {"action": "screenshot", "name": "03-built"},
    {"action": "dismiss_text"},
    {"action": "assert_money", "equals": 0},
    {"action": "walk_to", "x": 29, "y": 35},
    {"action": "run", "frames": 2, "keys": ["UP"]},
    {"action": "run", "frames": 20},
    {"action": "screenshot", "name": "04-fishery-and-manager"},
    {"action": "run", "frames": 2, "keys": ["A"]},
    {"action": "next_message", "times": 0},
    {"action": "next_message"},
    {"action": "screenshot", "name": "05-manager-asks-for-worker"},
    {"action": "press_until_task", "task": "Task_HandleChooseMonInput"},
    {"action": "run", "frames": 30},
    {"action": "press", "key": "DOWN", "wait": 20},
    {"action": "press", "key": "A", "wait": 60},
    {"action": "next_message", "times": 0},
    {"action": "screenshot", "name": "06-worker-ready"},
    {"action": "dismiss_text"}
  ]
}
